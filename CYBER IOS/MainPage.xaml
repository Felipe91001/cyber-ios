<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FFGhostCheat.MainPage"
             BackgroundColor="#1a1a1a">
    <!-- Fundo escuro estilo gamer -->

    <Grid RowDefinitions="*, Auto" ColumnDefinitions="*">

        <!-- Área Central: Mostra o status atual -->
        <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
            <Label Text="🎯 FF GHOST OVERLAY" FontSize="24" FontAttributes="Bold" TextColor="LimeGreen" HorizontalOptions="Center"/>
            <Label x:Name="lblStatus" Text="Aguardando ativação..." FontSize="18" TextColor="White" HorizontalOptions="Center"/>

            <!-- Indicador de Velocidade -->
            <BoxView HeightRequest="20" WidthRequest="200" Color="Gray" CornerRadius="10" />
            <Slider Minimum="1" Maximum="4" Value="1" x:Name="slFireRate" 
                    ValueChanged="OnSpeedChange" HorizontalOptions="Fill" />
            <Label x:Name="lblSpeed" Text="Velocidade: Nível 1" TextColor="Yellow" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Botões de Controle (Parte Inferior) -->
        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="10" BackgroundColor="#333333">

            <Button Text="👁️ ESP ON/OFF" Clicked="BtnEsp_Click" BackgroundColor="Blue" TextColor="White" />

            <Button Text="🎯 Aimbot (HS/Pescoço)" Clicked="BtnAim_Click" BackgroundColor="DarkRed" TextColor="White" />

            <Button Text="🔥 Modo Rage (Sem Recuo)" Clicked="BtnRage_Click" BackgroundColor="Orange" TextColor="Black" />

            <Button Text="💊 Kit Relâmpago + Fast Fire" Clicked="BtnKit_Click" BackgroundColor="Purple" TextColor="White" />

            <Button Text="🤫 SUMIR TUDO / ESCONDER" Clicked="BtnHide_Click" BackgroundColor="Gray" TextColor="White" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>